#!/usr/bin/make -f

export DH_VERBOSE = 1
export CGO_ENABLED = 0
export GOFLAGS = -mod=readonly

VERSION := $(shell dpkg-parsechangelog --show-field Version)
LDFLAGS := -s -w -X github.com/jp1337/easywall/internal/shared.CurrentVersion=$(VERSION)

%:
	dh $@

# Built into bin/ and installed below, rather than written straight into
# debian/easywall.
#
# dh_prep runs between these two targets, and emptying debian/easywall is its
# entire job — so everything the build wrote there was deleted before the
# package was assembled. "Binaries already placed by build step", this file
# said, and the .deb that came out held the units, the assets and the config
# and not one executable.
#
# Nothing noticed for as long as the package has existed: CI built the .deb and
# uploaded it without ever installing it. A downloaded artefact from a green run
# on main has no /usr/sbin entry at all, and on a host that installed it systemd
# answers status=203/EXEC — cannot execute — every five seconds, for ever.
override_dh_auto_build:
	go build -ldflags "$(LDFLAGS)" -o bin/easywall-core ./cmd/easywall-core
	go build -ldflags "$(LDFLAGS)" -o bin/easywall-web  ./cmd/easywall-web

override_dh_auto_install:
	# The two binaries this package exists to deliver
	install -d debian/easywall/usr/sbin
	install -m 0755 bin/easywall-core debian/easywall/usr/sbin/easywall-core
	install -m 0755 bin/easywall-web  debian/easywall/usr/sbin/easywall-web
	# Assets
	install -d debian/easywall/usr/share/easywall
	cp -r web locales debian/easywall/usr/share/easywall/
	# Config samples
	install -d debian/easywall/etc/easywall
	install -m 0640 config/easywall.toml debian/easywall/etc/easywall/easywall.toml
	# web.toml is generated by postinst (needs fresh secrets), install as template
	install -m 0640 config/web.toml debian/easywall/etc/easywall/web.toml.template
	# systemd units
	install -d debian/easywall/lib/systemd/system
	install -m 0644 systemd/easywall-core.service debian/easywall/lib/systemd/system/
	install -m 0644 systemd/easywall-web.service  debian/easywall/lib/systemd/system/
	# logrotate
	install -d debian/easywall/etc/logrotate.d
	install -m 0644 debian/easywall.logrotate debian/easywall/etc/logrotate.d/easywall

override_dh_auto_test:
	go test ./internal/...

override_dh_auto_clean:
	rm -rf bin
