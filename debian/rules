#!/usr/bin/make -f

export DH_VERBOSE = 1
export CGO_ENABLED = 0
export GOFLAGS = -mod=readonly

VERSION := $(shell dpkg-parsechangelog --show-field Version)
LDFLAGS := -s -w -X github.com/jp1337/easywall/internal/shared.CurrentVersion=$(VERSION)

%:
	dh $@

override_dh_auto_build:
	go build -ldflags "$(LDFLAGS)" -o debian/easywall/usr/sbin/easywall-core ./cmd/easywall-core
	go build -ldflags "$(LDFLAGS)" -o debian/easywall/usr/sbin/easywall-web  ./cmd/easywall-web

override_dh_auto_install:
	# Binaries already placed by build step
	# Assets
	install -d debian/easywall/usr/share/easywall
	cp -r web locales debian/easywall/usr/share/easywall/
	# Config samples
	install -d debian/easywall/etc/easywall
	install -m 0640 config/easywall.toml debian/easywall/etc/easywall/easywall.toml
	# web.toml is generated by postinst (needs fresh secrets), install as template
	install -m 0640 config/web.toml debian/easywall/etc/easywall/web.toml.template
	# systemd units
	install -d debian/easywall/lib/systemd/system
	install -m 0644 systemd/easywall-core.service debian/easywall/lib/systemd/system/
	install -m 0644 systemd/easywall-web.service  debian/easywall/lib/systemd/system/
	# logrotate
	install -d debian/easywall/etc/logrotate.d
	install -m 0644 debian/easywall.logrotate debian/easywall/etc/logrotate.d/easywall

override_dh_auto_test:
	go test ./internal/...
