/var/log/easywall/audit.log
/var/log/easywall/supervisord.log
{
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    # 600 root:root, matching what the daemon itself creates. The audit log is
    # the record of who changed the firewall; only easywall-core reads it, and
    # the web interface asks for entries over the socket rather than opening the
    # file. A rotation that recreated it 640 root:easywall would have handed
    # that read back every night.
    create 600 root root
}

# There is deliberately no postrotate here.
#
# easywall opens the audit log for each entry and closes it again, so a rotated
# file needs no signal: the next entry opens whatever `create` just made. The
# hook that used to live here sent SIGHUP to easywall-core — and until 2.5.0
# nothing handled that signal, so the default disposition applied and the daily
# log rotation *terminated the firewall daemon*. systemd restarted it five
# seconds later, which hid it; what it could not restore was an acceptance
# window open at that moment, whose goroutine went with the process, leaving
# unconfirmed rules live and the rollback unable to run.
#
# SIGHUP reloads the configuration now, so the hook would merely be pointless
# rather than harmful. It is still pointless.
