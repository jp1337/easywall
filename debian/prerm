#!/bin/bash
set -e

case "$1" in
  remove|upgrade|deconfigure)
    if [ -d /run/systemd/system ]; then
      systemctl stop    easywall-core.service easywall-web.service 2>/dev/null || true
      # easywall-selftest.service is oneshot and is not running, so there is
      # nothing to stop — but an enabled unit left behind after the package goes
      # points systemd at a deleted /usr/sbin/easywall-core on every boot.
      systemctl disable easywall-selftest.service 2>/dev/null || true
      systemctl disable easywall-core.service easywall-web.service 2>/dev/null || true
    fi
    ;;
esac

exit 0
