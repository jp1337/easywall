# The golang-go floor below is what the source actually needs: go.mod pins the
# toolchain to 1.27.0, and a build with GOTOOLCHAIN=local refuses anything older.
# It said >= 1.21 since the 2.0.0 rewrite, which was already false — the web
# process calls http.NewCrossOriginProtection, a Go 1.25 API. Debian trixie ships
# 1.24, so building this package there needs golang from backports; our own .deb
# is built in CI with the toolchain go.mod names.
Build-Depends: debhelper-compat (= 13), golang-go (>= 2:1.27~)
Standards-Version: 4.6.2
Homepage: https://easywall-project.org
