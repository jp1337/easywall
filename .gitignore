# Binaries
/easywall-core
/easywall-web
*.exe

# Build artifacts
bin/
dist/
build/

# Go test & coverage
coverage*.out
coverage*.html
*.test
*.out
*.prof

# GoReleaser
/dist

# SSL certificates (generated at runtime)
ssl/

# Runtime data (generated at runtime)
data/rules.json
data/version_cache.json
backup/*
!backup/.gitkeep


# Editor & OS
.DS_Store
.vscode/
.idea/
.worktrees/
*.swp
*.swo
*~

# Debian packaging artifacts
debian/.debhelper/
debian/easywall/
debian/files
debian/*.substvars
debian/*.debhelper
*.deb
*.changes

# Logs
*.log
node_modules/
tmp/

# Whatever agent runner or editor the person at the keyboard happens to use.
# Not project files, and not a statement about which tool anyone should use.
#
# .opencode/ is here the hard way: a blanket `git add -A` during the 2.7 work
# swept .opencode/opencode.json into a commit about the firewall daemon. The
# directory also carries its own node_modules, which line 50 above would have
# caught — the config file at its root was exactly the part that got through.
.claude/
.opencode/
.serena/

# Playwright storage state from documentation screenshot runs — it holds a
# session cookie and once got committed into the published assets directory.
state.json

# The documentation site as Jekyll renders it, plus the lock a local build
# writes. CI builds the site itself from docs/Gemfile — a lock generated by
# whatever Ruby happened to be on a contributor's machine can carry
# platform-specific gems that CI's Ruby cannot resolve.
docs/_site/
docs/Gemfile.lock
