[Unit]
Description=easywall Core Daemon (nftables firewall backend)
Documentation=https://easywall-project.org
After=network.target
Wants=network.target

# The start rate limit belongs to the unit, not to the service. systemd moved
# these two out of [Service] in v229 and keeps the old spelling working as a
# compatibility alias — measured on systemd 259, `StartLimitInterval=60s` in
# [Service] still reports StartLimitIntervalUSec=1min — so this was doing its
# job. It is written where it is documented anyway: a compatibility alias is a
# thing that can be removed, and the failure mode when it is would be silent.
# The unit would fall back to the manager defaults, 5 starts in 10s, and a
# crash-looping firewall daemon would keep restarting instead of stopping.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=root
# Group easywall, not root, and this is load-bearing.
#
# CapabilityBoundingSet below leaves this process with CAP_NET_ADMIN and nothing
# else — including no CAP_CHOWN and no CAP_DAC_OVERRIDE, which root normally
# leans on without noticing. With Group=root the daemon could not hand the
# control socket to the easywall group, so it stayed root:root 0660 and
# easywall-web, which runs as easywall, got "permission denied" on connect: a
# freshly installed package had a web interface that could not reach the core at
# all. Nor could it write /var/lib/easywall, which belongs to the web user.
#
# Being a member of the group solves both without widening the capability set:
# the owner of a file may give it to a group it belongs to, and the data
# directory is group-writable.
Group=easywall
ExecStart=/usr/sbin/easywall-core --config /etc/easywall/easywall.toml
ExecReload=/bin/kill -HUP $MAINPID

# Runtime socket directory. systemd creates it owned by this unit's User= and
# Group=, which is root:easywall — the ownership the web process needs to reach
# the socket. There is no RuntimeDirectoryGroup= directive; a line saying so sat
# here and systemd logged "Unknown key 'RuntimeDirectoryGroup' in section
# [Service], ignoring" on every load. The group was right anyway, by way of
# Group= above, which is the thing actually holding it up.
RuntimeDirectory=easywall
RuntimeDirectoryMode=0750

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=easywall-core

# Restart on failure with back-off. The rate limit that bounds it is in [Unit]
# above, which is where systemd documents it.
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# ProtectSystem is what gives ReadWritePaths anything to do: without it every
# path is writable already and the list below states a restriction that is not
# in force. "full" leaves /usr and /etc read-only apart from what is named here;
# /etc/easywall is named because the options and settings pages write
# easywall.toml through this daemon.
ProtectSystem=full
ReadWritePaths=/etc/easywall /var/lib/easywall /var/log/easywall /run/easywall
# nftables requires CAP_NET_ADMIN + direct kernel access. Nothing else is needed
# — see Group= above for why that is only true with the group membership.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
