[Unit]
Description=easywall Core Daemon (nftables firewall backend)
Documentation=https://easywall-project.org
After=network.target
Wants=network.target

# The start rate limit belongs to the unit, not to the service. systemd moved
# these two out of [Service] in v229 and keeps the old spelling working as a
# compatibility alias — measured on systemd 259, `StartLimitInterval=60s` in
# [Service] still reports StartLimitIntervalUSec=1min — so this was doing its
# job. It is written where it is documented anyway: a compatibility alias is a
# thing that can be removed, and the failure mode when it is would be silent.
# The unit would fall back to the manager defaults, 5 starts in 10s, and a
# crash-looping firewall daemon would keep restarting instead of stopping.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
# Type=notify, not simple, and the difference is an ordering bug.
#
# Under Type=simple the unit was "active (running)" the instant exec() returned.
# easywall-web.service has After=easywall-core.service, and what it is actually
# waiting for is /run/easywall/core.sock — which does not exist until the core
# has run its boot rule restore and called net.Listen, hundreds of milliseconds
# later. So systemd was free to start the web process into a socket that was not
# there, and the web process reports that as "the core is unreachable" on every
# page until something retries late enough.
#
# With Type=notify the unit is not active until the daemon sends READY=1, and
# Daemon.Start sends it after net.Listen *and* after the socket has its final
# ownership — see internal/core/sdnotify.go. NotifyAccess=main because only the
# main process ever sends it; anything else would be a datagram this unit should
# not accept.
Type=notify
NotifyAccess=main

# The watchdog. systemd sets $WATCHDOG_USEC from this, the daemon pings at half
# of it, and it stops pinging when it cannot establish that it is still
# answering — Daemon.pingWatchdog says exactly what that means and what was
# rejected. It stops on the *second* consecutive failure rather than the first:
# a single missed sample would land the next attempt on this deadline rather
# than inside it, because half of sixty is thirty and a Go ticker drifts late.
# So a contended daemon keeps its last ping at most one interval old, and a
# wedged one is killed at ninety seconds instead of sixty.
#
# It is deliberately not tight enough to fire on a slow apply. An nft call is
# bounded at thirty seconds and does not touch the lock the ping reads, so a
# core in the middle of `nft -f` still pings — which is the point. Killing the
# firewall daemon mid-apply is worse than anything a watchdog would be catching.
WatchdogSec=60s

User=root
# Group easywall, not root, and this is load-bearing.
#
# CapabilityBoundingSet below leaves this process with CAP_NET_ADMIN and nothing
# else — including no CAP_CHOWN and no CAP_DAC_OVERRIDE, which root normally
# leans on without noticing. With Group=root the daemon could not hand the
# control socket to the easywall group, so it stayed root:root 0660 and
# easywall-web, which runs as easywall, got "permission denied" on connect: a
# freshly installed package had a web interface that could not reach the core at
# all. Nor could it write /var/lib/easywall, which belongs to the web user.
#
# Being a member of the group solves both without widening the capability set:
# the owner of a file may give it to a group it belongs to, and the data
# directory is group-writable.
Group=easywall
ExecStart=/usr/sbin/easywall-core --config /etc/easywall/easywall.toml
ExecReload=/bin/kill -HUP $MAINPID

# Runtime socket directory. systemd creates it owned by this unit's User= and
# Group=, which is root:easywall — the ownership the web process needs to reach
# the socket. There is no RuntimeDirectoryGroup= directive; a line saying so sat
# here and systemd logged "Unknown key 'RuntimeDirectoryGroup' in section
# [Service], ignoring" on every load. The group was right anyway, by way of
# Group= above, which is the thing actually holding it up.
RuntimeDirectory=easywall
RuntimeDirectoryMode=0750

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=easywall-core

# Restart on failure with back-off. The rate limit that bounds it is in [Unit]
# above, which is where systemd documents it.
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
# ProtectSystem is what gives ReadWritePaths anything to do: without it every
# path is writable already and the list below states a restriction that is not
# in force. "full" leaves /usr and /etc read-only apart from what is named here;
# /etc/easywall is named because the options and settings pages write
# easywall.toml through this daemon.
ProtectSystem=full
ReadWritePaths=/etc/easywall /var/lib/easywall /var/log/easywall /run/easywall
# nftables requires CAP_NET_ADMIN + direct kernel access. Nothing else is needed
# — see Group= above for why that is only true with the group membership.
#
# These two lines are not widened, and easywall-selftest.service exists because
# of that. 2.17's self-test builds a throwaway network namespace to measure the
# rules it wrote against a real packet, and CLONE_NEWNET needs CAP_SYS_ADMIN —
# which the bounding set above removes from this root process, so the unshare
# fails before the first probe. Under this unit the daemon would have recorded
# "unprovable" on every Debian installation, which is the primary install
# target.
#
# The answer is not CAP_SYS_ADMIN here. This is the long-lived root daemon that
# holds the control socket and answers a network-facing process; widening it to
# buy a check that runs once per upgrade is the wrong trade, and it would
# contradict the sentence directly above. The proof gets its own oneshot unit
# instead — alive for milliseconds, holding no socket, listening on nothing —
# and that unit is the only place CAP_SYS_ADMIN appears in this repository.
# TestCapSysAdminIsGrantedByExactlyOneUnit is what keeps it there.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
