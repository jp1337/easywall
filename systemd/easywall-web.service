[Unit]
Description=easywall Web Interface
Documentation=https://easywall-project.org
After=network.target easywall-core.service
Wants=easywall-core.service

# In [Unit], where systemd documents it — see the note in easywall-core.service.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=easywall
Group=easywall
ExecStart=/usr/sbin/easywall-web --config /etc/easywall/web.toml

# Working directory — templates and static files are served relative to this
WorkingDirectory=/usr/share/easywall

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=easywall-web

# Restart on failure. The rate limit that bounds it is in [Unit] above.
Restart=on-failure
RestartSec=5s

# Security hardening — web process runs unprivileged
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/easywall /etc/easywall /run/easywall
# ssl_dir is deliberately not ReadOnlyPaths: easywall generates its own
# self-signed certificate there on first start and replaces it before it
# expires. Marking it read-only made both impossible — the process could not
# create the certificate it then tried to serve. File ownership is what keeps
# the rest of /etc/easywall out of reach: the directory is root-owned, and only
# web.toml and ssl/ belong to the easywall user.

# Allow network binding on port 12227 (>1024, no special cap needed)
# If binding on a privileged port, add: AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
