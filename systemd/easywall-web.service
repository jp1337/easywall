[Unit]
Description=easywall Web Interface
Documentation=https://jp1337.github.io/easywall
After=network.target easywall-core.service
Wants=easywall-core.service

[Service]
Type=simple
User=easywall
Group=easywall
ExecStart=/usr/sbin/easywall-web --config /etc/easywall/web.toml

# Working directory — templates and static files are served relative to this
WorkingDirectory=/usr/share/easywall

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=easywall-web

# Restart on failure
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Security hardening — web process runs unprivileged
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/easywall /etc/easywall /run/easywall
# TLS cert/key read access
ReadOnlyPaths=/etc/easywall/ssl

# Allow network binding on port 12227 (>1024, no special cap needed)
# If binding on a privileged port, add: AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
